<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:textColor">@color/text_white</item>
    </style>

    <!-- TV / Ayarlar Seçim Butonu Temel Stili -->
    <style name="TvSettingsButton">
        <item name="android:layout_height">36dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:background">@drawable/selector_chip</item>
    </style>

    <!-- Satır içi yan yana esnek buton stili (0dp, weight=1) -->
    <style name="TvSettingsButton.Row">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <!-- Tam genişlikte ayar butonu stili (match_parent) -->
    <style name="TvSettingsButton.Full">
        <item name="android:layout_width">match_parent</item>
    </style>

    <!-- Panel Kapatma Butonu Stili (DRY) -->
    <style name="TvCloseButton">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:text">✕</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:background">@drawable/selector_chip</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Panel Başlık Stili (DRY) -->
    <style name="TvPanelTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_white</item>
    </style>

    <!-- Ayar Alt Başlık / Açıklama Stili (DRY) -->
    <style name="TvSectionSubtitle">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>
</resources>
