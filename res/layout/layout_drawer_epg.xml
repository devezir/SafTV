<?xml version="1.0" encoding="utf-8"?>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/layout_epg_drawer"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:background="@drawable/bg_drawer"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- Header: Channel Name, Date & Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tv_epg_drawer_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="📅 TRT 1 - Yayın Akışı" />

            <Button
                android:id="@+id/btn_close_epg_drawer"
                style="@style/TvCloseButton"
                android:textColor="@color/text_gray" />
        </LinearLayout>

        <!-- EPG Status / Info Label -->
        <TextView
            android:id="@+id/tv_epg_drawer_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_blue"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="Bugünün 24 Saatlik Akışı"
            android:layout_marginBottom="6dp" />

        <!-- Program List -->
        <ListView
            android:id="@+id/lv_epg_programs"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="3dp"
            android:scrollbars="vertical" />

        <!-- EPG Drawer Footer Hint -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:textColor="@color/text_gray"
            android:textSize="10sp"
            android:text="[▲▼] Gezin  |  [GERİ/✕] Kapat" />
    </LinearLayout>
