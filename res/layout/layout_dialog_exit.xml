<?xml version="1.0" encoding="utf-8"?>
    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/layout_exit_dialog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_osd"
            android:orientation="vertical"
            android:padding="20dp"
            android:clickable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📺 SAF TV"
                android:textColor="@color/accent_blue"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Uygulamadan çıkmak istiyor musunuz?"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_exit_settings"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="⚙️ Ayarlar"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_blue"
                    android:background="@drawable/selector_chip"
                    android:nextFocusRight="@+id/btn_exit_cancel"
                    android:layout_marginRight="6dp" />

                <Button
                    android:id="@+id/btn_exit_cancel"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="✕ Vazgeç"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:background="@drawable/selector_chip"
                    android:nextFocusLeft="@+id/btn_exit_settings"
                    android:nextFocusRight="@+id/btn_exit_confirm"
                    android:layout_marginRight="6dp" />

                <Button
                    android:id="@+id/btn_exit_confirm"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="✓ Çıkış"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_red"
                    android:background="@drawable/selector_chip"
                    android:nextFocusLeft="@+id/btn_exit_cancel" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
