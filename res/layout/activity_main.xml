<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:keepScreenOn="true">

    <!-- Video Surface -->
    <SurfaceView
        android:id="@+id/surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Audio-Only / Radio Mode Overlay (Screen Saver & Data Saver) -->
    <FrameLayout
        android:id="@+id/layout_audio_only_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0d1117"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/card_audio_only"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_osd">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📻"
                android:textSize="52sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_audio_only_channel_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="TRT 1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:text="● SADECE SES / RADYO MODU AKTİF" />

            <TextView
                android:id="@+id/tv_audio_only_savings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_blue"
                android:textSize="11sp"
                android:layout_marginTop="6dp"
                android:text="🚀 %95+ Veri Tasarrufu • Video Akışı Kapalı" />

            <!-- Bilgilendirme Rozeti (Görüntüyü Geri Açma Rehberi) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_osd"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tv_audio_only_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 Görüntüyü açmak için Kalite Menüsü'nden\n(Yeşil Tuş veya Ayarlar ➔ Kalite) bir video çözünürlüğü seçiniz."
                    android:textColor="@color/text_white"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Center Loading Spinner -->
    <ProgressBar
        android:id="@+id/loading_spinner"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="visible" />

    <!-- Center Status Text (Buffering / Reconnecting) -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="50dp"
        android:background="@drawable/bg_osd"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="@color/text_white"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Network Disconnected Warning Badge -->
    <LinearLayout
        android:id="@+id/layout_network_alert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_network_alert"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:elevation="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📶"
            android:textSize="13sp"
            android:layout_marginRight="6dp" />

        <TextView
            android:id="@+id/tv_network_alert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="İnternet Bağlantısı Kesildi!"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Full Screen Touch & OSD Controls Overlay -->
    <!-- OSD & Controls Overlay -->
    <include layout="@layout/layout_overlay_osd" />


    <!-- Semi-transparent Dim Backdrop (Dismisses panels on touch outside) -->
    <View
        android:id="@+id/view_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <!-- Side Channel List Drawer (Overlay - Compact & Space-optimized) -->
    <!-- Left Channel List Drawer -->
    <include layout="@layout/layout_drawer_channels" />

    <!-- Right 24-Hour EPG Schedule Drawer -->
    <include layout="@layout/layout_drawer_epg" />

    <!-- Quick Quality Menu (Green Key) -->
    <include layout="@layout/layout_panel_quick_quality" />

    <!-- Settings Dialog / Panel (9 Tabs) -->
    <include layout="@layout/layout_panel_settings" />

    <!-- Exit Confirmation Dialog -->
    <include layout="@layout/layout_dialog_exit" />

</FrameLayout>
