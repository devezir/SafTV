<?xml version="1.0" encoding="utf-8"?>
    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/layout_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- Top Bar Multi-Line / Single-Row Container -->
        <LinearLayout
            android:id="@+id/layout_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="14dp">

            <!-- Row 1: OSD Channel Info + Quick Touch Action Buttons (Side by Side in Landscape/TV; Wraps in Portrait) -->
            <LinearLayout
                android:id="@+id/layout_header_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- OSD Channel Info Banner (Clickable to open Channel Drawer) -->
                <LinearLayout
                    android:id="@+id/layout_osd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_osd"
                    android:paddingLeft="12dp"
                    android:paddingRight="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:clickable="true"
                    android:focusable="false"
                    android:focusableInTouchMode="false">

                    <TextView
                        android:id="@+id/tv_osd_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="34dp"
                        android:minHeight="34dp"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:gravity="center"
                        android:background="@drawable/bg_badge"
                        android:textColor="@color/text_white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:text="1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginLeft="10dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_osd_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_white"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:text="TRT 1" />

                            <TextView
                                android:id="@+id/tv_osd_fav"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/accent_yellow"
                                android:textSize="15sp"
                                android:layout_marginLeft="6dp"
                                android:text="★"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_osd_cat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/accent_blue"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:text="ULUSAL" />

                            <TextView
                                android:id="@+id/tv_osd_quality"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:textColor="@color/accent_green"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:text="● CANLI [Otomatik]" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Digital Clock in OSD -->
                    <TextView
                        android:id="@+id/tv_osd_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="14dp"
                        android:textColor="@color/text_white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:text="21:30" />

                    <!-- Network & Data Usage in OSD -->
                    <TextView
                        android:id="@+id/tv_osd_network_meter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:textColor="#38BDF8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="📶 0.0 Mbps • 0 MB" />
                </LinearLayout>

                <!-- Quick Touch Action Buttons Bar (Sits nicely beside OSD on Landscape/TV; Wraps on narrow screen) -->
                <HorizontalScrollView
                    android:id="@+id/scroll_touch_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layout_touch_actions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_osd"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btn_touch_quality"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="34dp"
                            android:text="📶 Kalite"
                            android:textSize="11sp"
                            android:textColor="@color/accent_green"
                            android:background="@drawable/selector_chip"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:layout_marginRight="4dp"
                            android:focusable="false"
                            android:focusableInTouchMode="false" />

                        <Button
                            android:id="@+id/btn_touch_aspect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="34dp"
                            android:text="📺 Ekran"
                            android:textSize="11sp"
                            android:textColor="@color/accent_blue"
                            android:background="@drawable/selector_chip"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:layout_marginRight="4dp"
                            android:focusable="false"
                            android:focusableInTouchMode="false" />

                        <Button
                            android:id="@+id/btn_touch_pip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="34dp"
                            android:text="🗗 PiP"
                            android:textSize="11sp"
                            android:textColor="#A78BFA"
                            android:background="@drawable/selector_chip"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:layout_marginRight="4dp"
                            android:focusable="false"
                            android:focusableInTouchMode="false" />

                        <Button
                            android:id="@+id/btn_touch_settings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="34dp"
                            android:text="⚙️ Ayarlar"
                            android:textSize="11sp"
                            android:textColor="@color/text_white"
                            android:background="@drawable/selector_chip"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:layout_marginRight="4dp"
                            android:focusable="false"
                            android:focusableInTouchMode="false" />

                        <Button
                            android:id="@+id/btn_touch_epg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="34dp"
                            android:text="📅 Akış"
                            android:textSize="11sp"
                            android:textColor="#38BDF8"
                            android:background="@drawable/selector_chip"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:layout_marginRight="4dp"
                            android:focusable="false"
                            android:focusableInTouchMode="false" />

                        <Button
                            android:id="@+id/btn_touch_exit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="34dp"
                            android:text="🚪 Çıkış"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_red"
                            android:background="@drawable/selector_chip"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:focusable="false"
                            android:focusableInTouchMode="false" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Row 2: OSD Mini EPG (Şu An / Sonraki Program & Canlı İlerleme Çubuğu) -->
            <LinearLayout
                android:id="@+id/layout_osd_epg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_osd"
                android:paddingLeft="12dp"
                android:paddingRight="14dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Şu An Yayındaki Program -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_red"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:text="🔴 ŞU AN: " />

                    <TextView
                        android:id="@+id/tv_epg_now_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_amber"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:text="10:30 - 13:15"
                        android:layout_marginRight="6dp" />

                    <TextView
                        android:id="@+id/tv_epg_now_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="Program Adı" />
                </LinearLayout>

                <!-- İlerleme Çubuğu & Kalan Süre -->
                <LinearLayout
                    android:id="@+id/layout_epg_progress_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="3dp">

                    <ProgressBar
                        android:id="@+id/pb_epg_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="150dp"
                        android:layout_height="4dp"
                        android:max="100"
                        android:progress="50"
                        android:progressTint="@color/active_green" />

                    <TextView
                        android:id="@+id/tv_epg_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:layout_marginLeft="8dp"
                        android:text="35 dk kaldı" />
                </LinearLayout>

                <!-- Sırada Ne Var -->
                <LinearLayout
                    android:id="@+id/layout_epg_next_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:text="⚪ SIRADA: " />

                    <TextView
                        android:id="@+id/tv_epg_next_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_gray"
                        android:textSize="11sp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="(13:15) Sonraki Program" />
                </LinearLayout>
            </LinearLayout>

            <!-- Remote D-Pad Navigation Hint -->
            <TextView
                android:id="@+id/tv_osd_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_osd"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="@color/text_gray"
                android:textSize="10sp"
                android:text="▲▼ Kanal | [OK] Liste | [▶] Akış | [Yeşil] Kalite | [Sarı] Favori | [Menü] Ayarlar" />
        </LinearLayout>

        <!-- Floating Left Prev Channel Button (Touch) -->
        <TextView
            android:id="@+id/btn_touch_prev"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="left|center_vertical"
            android:layout_marginLeft="14dp"
            android:background="@drawable/bg_circle_button"
            android:gravity="center"
            android:text="◀"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false" />

        <!-- Floating Right Next Channel Button (Touch) -->
        <TextView
            android:id="@+id/btn_touch_next"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="right|center_vertical"
            android:layout_marginRight="14dp"
            android:background="@drawable/bg_circle_button"
            android:gravity="center"
            android:text="▶"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false" />

        <!-- Center Play/Pause Touch Control (Option 2A) -->
        <LinearLayout
            android:id="@+id/btn_touch_play_pause"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_button"
            android:gravity="center"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <TextView
                android:id="@+id/tv_play_pause_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏸"
                android:textColor="@color/text_white"
                android:textSize="28sp" />
        </LinearLayout>
    </FrameLayout>
