<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/selector_channel_item"
    android:focusable="true"
    android:clickable="true">

    <!-- Row 1: Time & Live Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_epg_item_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/accent_amber"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="10:30 - 13:15" />

        <TextView
            android:id="@+id/tv_epg_item_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:textColor="@color/active_green"
            android:textSize="10sp"
            android:textStyle="bold"
            android:text="● CANLI"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Row 2: Title -->
    <TextView
        android:id="@+id/tv_epg_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="Program Başlığı" />

    <!-- Row 3: Description (Collapsed/single line or short) -->
    <TextView
        android:id="@+id/tv_epg_item_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="@color/text_gray"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Program açıklaması..."
        android:visibility="gone" />

</LinearLayout>
