<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="38dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/selector_channel_item">

    <!-- Channel Number Badge -->
    <TextView
        android:id="@+id/tv_item_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="28dp"
        android:minHeight="28dp"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:gravity="center"
        android:background="@drawable/bg_badge"
        android:textColor="@color/text_white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:text="1" />

    <!-- Channel Name & Live Program in a Two-Line Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_item_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="TRT 1" />

            <TextView
                android:id="@+id/tv_item_fav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_yellow"
                android:textSize="13sp"
                android:layout_marginLeft="4dp"
                android:text="★"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_item_cat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_gray"
                android:textSize="10sp"
                android:layout_marginLeft="6dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="• Ulusal" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_item_epg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="🔴 Alişan İle Hayata Gülümse"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Live Badge -->
    <TextView
        android:id="@+id/tv_item_live"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#10B981"
        android:textSize="10sp"
        android:textStyle="bold"
        android:text="CANLI" />

</LinearLayout>
